# Server Port
PORT=8080

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017/food_ordering_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/food_ordering_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/food_ordering_db

# JWT Secret Key (Minimum 256-bit / 32-character random string or hex)
JWT_SECRET=replace_this_with_a_secure_256_bit_random_secret_key_in_production
# JWT Token expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# Initial Administrator Seed Credentials (created automatically on startup if specified and does not exist)
ADMIN_EMAIL=admin@foodordering.com
ADMIN_PASSWORD=AdminSecurePassword123!
